# Modele du fichier .env.prod du serveur (hors depot, ignore par git, droits 600).
# Ne JAMAIS commiter la version remplie.
#
# La reference de l'image (APP_IMAGE) ne se saisit pas ici : ./deploy.sh la lit dans
# deploy/manifest.json, sous la forme ghcr.io/espi-teamstarrs/mcp-server@sha256:<digest>.

DEBUG=false

# Dossier de documentation indexe (BM25), monte en lecture seule dans le conteneur (/app/documentations).
DOCS_PATH=./documentations
